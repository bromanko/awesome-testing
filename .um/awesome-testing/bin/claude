#!/usr/bin/env python3
"""Constrain the UM-native Claude harness to evidence-only model responses."""

import os
from pathlib import Path
import sys

real = Path(os.environ.get("AWESOME_TESTING_REAL_CLAUDE", str(Path(__file__).with_name("real-claude"))))
if real.resolve() == Path(__file__).resolve():
    raise SystemExit("Claude wrapper must point to the host executable")
arguments = sys.argv[1:]
if "--version" not in arguments and "--help" not in arguments:
    # Preserve UM's native stream/result protocol but remove ambient tools,
    # settings/hooks, and MCP servers. StructuredOutput remains the sole result tool.
    if "--setting-sources" in arguments:
        arguments[arguments.index("--setting-sources") + 1] = ""
    arguments += ["--tools", "", "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
                  "--max-budget-usd", "1.00", "--bare", "--disable-slash-commands"]
os.execv(str(real), [str(real), *arguments])
